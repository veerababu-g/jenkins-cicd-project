
pipeline {
    agent any

    environment {
        IMAGE_NAME = "jenkins-cicd"
        DOCKERHUB_USER = "veerababu324"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Downloading source code from GitHub'

                git branch: 'main',
                    url: 'https://github.com/veerababu-g/jenkins-cicd-project'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image'
                sh 'docker build -t sample-web-app .'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application'
            }
        }
    }
}

